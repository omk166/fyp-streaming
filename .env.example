# Copy to .env. npm start loads it; deploy/setup.sh also loads it in systemd.
# APP_ORIGIN is required for Google sign-in and for deployments behind a TLS proxy.
# No trailing slash. For local Google testing use http://localhost:3000 instead.
APP_ORIGIN=https://84-12-183-78.sslip.io

# Optional: both must be set together to enable Google sign-in.
# Never commit the real values. Register this redirect URI in Google Cloud:
# https://84-12-183-78.sslip.io/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults to data/auth.sqlite, outside public/. Back up the database with its WAL.
# AUTH_DB_PATH=/var/lib/fyp-streaming/auth.sqlite

# Transcription runs on each participant's own computer (speech/README.md); this server never receives audio.
# Where pages look for that local speech service. Default http://127.0.0.1:8765.
# LOCAL_SPEECH_URL=
